---
import '@fontsource-variable/inter';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(248 191 65);
    --aw-color-secondary: rgb(22 22 33);
    --aw-color-accent: rgb(15 118 110);

    --aw-color-text-heading: rgb(15 23 42);
    --aw-color-text-default: rgb(31 24 17);
    --aw-color-text-muted: rgb(31 24 17 / 70%);
    --aw-color-bg-page: rgb(250 248 244);

    --aw-color-bg-page-dark: rgb(7 9 22);

    ::selection {
      background-color: rgba(248, 191, 65, 0.4);
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(248 191 65);
    --aw-color-secondary: rgb(248 191 65);
    --aw-color-accent: rgb(94 234 212);

    --aw-color-text-heading: rgb(248 250 252);
    --aw-color-text-default: rgb(226 232 240);
    --aw-color-text-muted: rgb(226 232 240 / 60%);
    --aw-color-bg-page: rgb(7 9 22);

    ::selection {
      background-color: rgb(248 191 65 / 0.4);
      color: black;
    }
  }
</style>
