---
import Layout from '~/layouts/PageLayout.astro';
import EntryMeta from '~/components/entries/EntryMeta.astro';
import SourceBox from '~/components/entries/SourceBox.astro';
import EntryCard from '~/components/entries/EntryCard.astro';
import type { Entry } from '~/types';
import { fetchEntries, getRelatedEntries } from '~/utils/entries';

export async function getStaticPaths() {
  const entries = await fetchEntries();
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: Entry };
const related = await getRelatedEntries(entry, 3);
const metadata = {
  title: entry.title,
  description: entry.summary,
  openGraph: {
    type: 'article',
    url: entry.permalink,
  },
};
---

<Layout metadata={metadata}>
  <article class="mx-auto max-w-3xl py-16 space-y-8">
    <div class="space-y-4">
      <p class="text-xs uppercase tracking-[0.4em] text-primary">Notebook entry</p>
      <h1 class="text-4xl font-semibold leading-tight">{entry.title}</h1>
      <EntryMeta entry={entry} />
      {entry.tags && entry.tags.length > 0 && (
        <ul class="flex flex-wrap gap-2 text-xs text-muted">
          {entry.tags.map((tag) => (
            <li class="px-3 py-1 rounded-full border border-gray-200 dark:border-white/10">#{tag}</li>
          ))}
        </ul>
      )}
    </div>

    <SourceBox entry={entry} />

    {entry.Content && (
      <section class="prose prose-lg dark:prose-invert max-w-none">
        <entry.Content />
      </section>
    )}
  </article>

  {related.length > 0 && (
    <section class="max-w-5xl mx-auto py-12 space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-semibold">Related entries</h2>
        <a class="text-sm text-primary" href="/library">Browse library</a>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {related.map((item) => (
          <EntryCard entry={item} />
        ))}
      </div>
    </section>
  )}
</Layout>
