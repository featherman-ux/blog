---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About',
  description: "A tiny bio so the site doesn't look like a ghost town.",
};
---

<Layout metadata={metadata}>
  <section class="max-w-3xl mx-auto py-14 space-y-4">
    <h1 class="text-4xl font-semibold">About</h1>
    <p class="text-lg text-muted">I'm Niels Veerman.</p>
    <p class="text-base text-muted">
      I read books and papers and write short notes so my brain doesn't pretend it never happened. Sometimes it's tech,
      sometimes it's people, sometimes it's neither.
    </p>
    <p class="text-base text-muted">That's the whole story for now.</p>
  </section>
</Layout>
