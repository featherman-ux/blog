---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Over',
  description: 'Even voorstellen',
};
---

<Layout metadata={metadata}>
  <section class="max-w-3xl mx-auto py-14 space-y-4">
    <h1 class="text-4xl font-semibold">Over</h1>
    <p class="text-lg text-muted">Ik ben Niels.</p>
    <p class="text-base text-muted">
      Ik lees boeken en artikelen en schrijf korte aantekeningen zodat mijn brein niet doet alsof het nooit is gebeurd.
      Soms gaat het over technologie, soms over mensen, soms over iets anders.
    </p>
    <p class="text-base text-muted">Dat is het hele verhaal voor nu.</p>
  </section>
</Layout>
