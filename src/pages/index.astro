---
import Layout from '~/layouts/PageLayout.astro';
import EntryCard from '~/components/entries/EntryCard.astro';
import { getLatestEntries } from '~/utils/entries';

const metadata = {
  title: "Niels' notitieblok",
  description: 'Kleine persoonlijke site over dingen die ik heb gelezen/gezien/gehoord.',
};

const latest = await getLatestEntries(3);
const hasEntries = latest.length > 0;
---

<Layout metadata={metadata}>
  <section class="py-16 max-w-3xl mx-auto text-center space-y-4">
    <p class="text-xs uppercase tracking-[0.5em] text-primary">Niels' notitieblok</p>
    <h1 class="text-4xl md:text-5xl font-semibold">Niels' notitieblok</h1>
    <p class="text-lg text-muted">Een website om mijn gedachten te synthetiseren. Meestal over dingen die ik lees.</p>
    <p class="text-base text-muted">
      Crazyyyyyyy goodtimes!! Over het algemeen vergeet ik steeds wat ik heb gelezen en met deze website hoop ik dit te
      tackelen!! Dit is voor mijzelf dus als je dit leest dan is dat gek.
    </p>
    <p class="text-base text-muted">
      Kleine persoonlijke site. Geen groot plan. Ik zal in de loop van de tijd dingen toevoegen.
    </p>
    <p class="text-sm text-muted">Als het leeg uitziet, is dat omdat het dat is.</p>
  </section>

  <section class="py-10 space-y-4 max-w-3xl mx-auto">
    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-semibold">Laatste</h2>
      <a class="text-sm text-primary" href="/library">Bibliotheek</a>
    </div>
    <p class="text-muted">Nog niets gepubliceerd</p>
    {
      hasEntries && (
        <div class="space-y-4">
          {latest.map((entry) => (
            <EntryCard entry={entry} />
          ))}
        </div>
      )
    }
  </section>
</Layout>
