---
import Layout from '~/layouts/PageLayout.astro';
import EntryCard from '~/components/entries/EntryCard.astro';
import { getLatestEntries } from '~/utils/entries';

const metadata = {
  title: "Niels' notebook",
  description: 'Small personal site for notes about whatever I just read.',
};

const latest = await getLatestEntries(3);
const hasEntries = latest.length > 0;
---

<Layout metadata={metadata}>
  <section class="py-16 max-w-3xl mx-auto text-center space-y-4">
    <p class="text-xs uppercase tracking-[0.5em] text-primary">Niels' notebook</p>
    <h1 class="text-4xl md:text-5xl font-semibold">Niels' notebook</h1>
    <p class="text-lg text-muted">I read things. I write things. Mostly to remember what I thought.</p>
    <p class="text-base text-muted">This is my website. I read stuff. I write about it.</p>
    <p class="text-base text-muted">This is a small personal site. No big plan. I'll add notes over time.</p>
    <p class="text-sm text-muted">If it looks empty, that's because it is.</p>
  </section>

  <section class="py-10 space-y-4 max-w-3xl mx-auto">
    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-semibold">Latest</h2>
      <a class="text-sm text-primary" href="/library">Library</a>
    </div>
    <p class="text-muted">No notes published yet.</p>
    {
      hasEntries && (
        <div class="space-y-4">
          {latest.map((entry) => (
            <EntryCard entry={entry} />
          ))}
        </div>
      )
    }
  </section>
</Layout>
