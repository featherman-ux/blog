---
import Layout from '~/layouts/PageLayout.astro';
import EntryCard from '~/components/entries/EntryCard.astro';
import { fetchEntries } from '~/utils/entries';

const metadata = {
  title: 'Library',
  description: 'Every note that actually makes it onto the site.',
};

const entries = await fetchEntries();
const hasEntries = entries.length > 0;
---

<Layout metadata={metadata}>
  <section class="py-12 space-y-4 text-center max-w-3xl mx-auto">
    <h1 class="text-4xl font-semibold">Library</h1>
    <p class="text-lg text-muted">All the notes in one place.</p>
  </section>

  {
    hasEntries ? (
      <section class="pb-12 space-y-6 max-w-4xl mx-auto">
        <div class="grid gap-6">
          {entries.map((entry) => (
            <EntryCard entry={entry} />
          ))}
        </div>
      </section>
    ) : (
      <section class="pb-12 text-center space-y-2 max-w-3xl mx-auto">
        <p class="text-base text-muted">Nothing here yet.</p>
        <p class="text-sm text-muted">Check back later.</p>
      </section>
    )
  }
</Layout>
